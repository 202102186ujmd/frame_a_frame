# ============================================================
#  frame_a_frame – environment variables reference
#  Copy this file to .env and fill in your values.
#  The .env file is git-ignored; never commit real credentials.
# ============================================================

# ----- Drone stream URLs (MediaMTX WebRTC / WHEP) -----------
# Each URL embeds the credentials for that channel.
# Defaults shown below are the three production drones.
DRONE_DC1001_URL=https://droneStream:KHlQlNfZVPtjg4a09Rn9Vo@droni.seguridad.sv:8889/Castillo001
DRONE_DC1002_URL=https://droneStream:KHlQlNfZVPtjg4a09Rn9Vo@droni.seguridad.sv:8889/Mjsp002
DRONE_DC1003_URL=https://droneStream:KHlQlNfZVPtjg4a09Rn9Vo@droni.seguridad.sv:8889/DCI003

# ----- HTTP / WebSocket server --------------------------------
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# ----- SSL (optional) ----------------------------------------
# Provide absolute paths to your certificate and key files to
# enable HTTPS/WSS.  Leave blank to run plain HTTP/WS.
#
# Example (Let's Encrypt / certbot):
#   SSL_CERT=/etc/letsencrypt/live/example.com/fullchain.crt
#   SSL_KEY=/etc/letsencrypt/live/example.com/server.key
#
# Self-signed (development):
#   openssl req -x509 -newkey rsa:4096 -keyout server.key \
#               -out fullchain.crt -days 365 -nodes
#
SSL_CERT=
SSL_KEY=

# ----- Capture settings --------------------------------------
CAPTURE_FPS=1
CAPTURE_WIDTH=1280
CAPTURE_HEIGHT=720

# ----- Reconnect / back-off ---------------------------------
RECONNECT_DELAY=5      # seconds between reconnect attempts
STALE_TIMEOUT=10       # seconds without a new frame → stale
